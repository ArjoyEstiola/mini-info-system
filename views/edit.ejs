<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Record</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar">
    <div class="container">
      <h1>Edit Record</h1>
      <a href="/">&larr; Back to List</a>
    </div>
  </header>

  <div class="container">
    <div class="card">
      <form class="record-form" action="/records/<%= record.id %>/edit" method="POST">
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" required value="<%= record.name %>">

        <label for="email">Email</label>
        <input type="email" id="email" name="email" required value="<%= record.email %>">

        <label for="phone">Phone</label>
        <input type="text" id="phone" name="phone" value="<%= record.phone %>">

        <label for="department">Department</label>
        <input type="text" id="department" name="department" value="<%= record.department %>">

        <button class="btn-primary" type="submit">Update Record</button>
        <a class="btn-secondary" href="/">Cancel</a>
      </form>
    </div>
  </div>
</body>
</html>
